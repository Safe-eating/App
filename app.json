{
  "expo": {
    "name": "SafeBite",
    "slug": "safebite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SafeBite uses the camera to scan product barcodes so it can look up what is inside them."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E4F5EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermissionText": "SafeBite uses the camera to scan product barcodes so it can look up what is inside them."
        }
      ]
    ]
  }
}
